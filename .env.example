# Copy to .env and fill in. Never commit .env.

# Contact form delivery (https://www.emailjs.com). All three come from the EmailJS dashboard:
#   Service ID  -> Email Services
#   Template ID -> Email Templates (the one using docs/email-templates/contact-notification.html)
#   Public key  -> Account -> General
# Leave any of them empty and the form falls back to opening the visitor's email app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
